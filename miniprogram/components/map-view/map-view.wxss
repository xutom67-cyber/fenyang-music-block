.mv-wrap { position: relative; width: 100%; height: 100%; overflow: hidden; }
.mv-map { width: 100%; height: 100%; }
.mv-zoom { position: absolute; right: 10rpx; bottom: 10rpx; display: flex; flex-direction: column; gap: 8rpx; z-index: 3; }
.mv-zbtn {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; background: rgba(255,255,255,.94);
  color: #4F6B58; font-size: 30rpx; font-weight: 700; display: flex; align-items: center;
  justify-content: center; box-shadow: 0 2rpx 10rpx rgba(47,63,53,.18);
}
