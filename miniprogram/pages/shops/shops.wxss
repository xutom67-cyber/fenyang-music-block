page { background: #F4F7F2; }
.page { padding-bottom: 60rpx; }
.page-sub { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx 20rpx; }
.sub-title { font-size: 34rpx; font-weight: 800; }
.sec-head { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 32rpx; }
.sh-b { font-size: 28rpx; font-weight: 800; }
.sh-s { font-size: 20rpx; color: #9AA49B; }
.shop-item { display: flex; align-items: center; gap: 24rpx; margin: 0 24rpx 20rpx; background: #fff; border-radius: 28rpx; padding: 24rpx 28rpx; box-shadow: 0 6rpx 24rpx rgba(47,63,53,.05); }
.si-glyph { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: #EDF6EF; border: 1.5px solid #CFE3D4; color: #4F8F71; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 30rpx; flex-shrink: 0; }
.si-info { flex: 1; min-width: 0; }
.si-name { font-size: 27rpx; font-weight: 700; }
.si-meta { font-size: 21rpx; color: #9AA49B; margin-top: 4rpx; }
.si-right { text-align: right; }
.si-rate { font-size: 23rpx; color: #C9962F; font-weight: 700; }
.si-status { display: inline-block; font-size: 20rpx; margin-top: 6rpx; padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 600; }
.si-status.ok { background: #E8F4EC; color: #4E9A6B; }
.si-status.busy { background: #FBF3DC; color: #B08A2E; }
.footer-note { text-align: center; font-size: 20rpx; color: #A9B2AA; margin: 40rpx 40rpx 0; line-height: 1.7; }
