page { background: #F4F7F2; }
.page { padding-bottom: 40rpx; }
.home-head { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx 16rpx; }
.hh-brand { display: flex; align-items: center; gap: 20rpx; }
.brand-logo {
  width: 80rpx; height: 80rpx; border-radius: 26rpx;
  background: linear-gradient(135deg, #7FB69A, #5E9C80); color: #fff; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(94,156,128,.30);
}
.brand-title { font-size: 32rpx; font-weight: 800; }
.brand-sub { font-size: 21rpx; color: #9AA49B; margin-top: 4rpx; }
.hh-loc { font-size: 21rpx; font-weight: 600; color: #4F8F71; background: #E8F4EC; padding: 8rpx 20rpx; border-radius: 999rpx; }
.hh-search {
  display: flex; align-items: center; gap: 16rpx; margin: 8rpx 28rpx 20rpx;
  background: #fff; border: 1.5px solid #E2E8E0; border-radius: 28rpx; padding: 20rpx 28rpx;
  color: #A9B2AA; font-size: 25rpx;
}
.hs-ic { font-style: normal; font-size: 28rpx; }

.map-card { margin: 0 24rpx; background: #fff; border-radius: 36rpx; padding: 24rpx 24rpx 20rpx; box-shadow: 0 12rpx 36rpx rgba(47,63,53,.06); }
.map-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.map-title { font-size: 28rpx; font-weight: 800; }
.layer-switch { display: flex; background: #F2F5F0; border-radius: 999rpx; padding: 4rpx; }
.ls-btn { font-size: 22rpx; color: #7B877E; padding: 8rpx 22rpx; border-radius: 999rpx; }
.ls-btn.on { background: #fff; color: #3E7A5F; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(47,63,53,.10); }
.map-holder { width: 100%; height: 760rpx; border-radius: 24rpx; overflow: hidden; }
.legend { display: flex; gap: 20rpx; flex-wrap: wrap; margin-top: 16rpx; font-size: 20rpx; color: #7B877E; align-items: center; }
.lg-item { display: inline-flex; align-items: center; gap: 8rpx; }
.lg { width: 18rpx; height: 18rpx; border-radius: 4rpx; }
.lg-dia { width: 0; height: 0; border-left: 9rpx solid transparent; border-right: 9rpx solid transparent; border-bottom: 14rpx solid #7FB69A; }
.lg-ven { width: 16rpx; height: 16rpx; border-radius: 50%; background: #7FB69A; border: 3rpx solid #fff; box-shadow: 0 0 0 1.5rpx #7FB69A; }
.lg-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; border: 3rpx solid #C9A96A; }
.lg-node { width: 20rpx; height: 20rpx; border-radius: 50%; background: #7FB69A; color: #fff; font-size: 14rpx; display: flex; align-items: center; justify-content: center; }
.layer-hint { font-size: 20rpx; color: #9AA49B; margin-top: 12rpx; }

.home-banner { margin: 24rpx 24rpx 0; height: 260rpx; border-radius: 36rpx; overflow: hidden; }
.hb-slide { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 0 40rpx; box-sizing: border-box; }
.hb-note { position: absolute; right: 28rpx; top: 20rpx; font-size: 44rpx; color: rgba(255,255,255,.5); transform: rotate(8deg); }
.hb-t { font-size: 34rpx; font-weight: 800; color: #fff; }
.hb-s { font-size: 22rpx; color: rgba(255,255,255,.88); margin-top: 12rpx; }
.hb-cta { align-self: flex-start; margin-top: 24rpx; font-size: 21rpx; font-weight: 700; color: #fff; background: rgba(255,255,255,.22); border: 1px solid rgba(255,255,255,.5); padding: 8rpx 24rpx; border-radius: 999rpx; }
.home-dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 16rpx; }
.hd { width: 12rpx; height: 12rpx; border-radius: 50%; background: #D8DED4; transition: all .2s; }
.hd.on { width: 32rpx; border-radius: 6rpx; background: #5E9C80; }

.home-entries { display: flex; justify-content: space-around; margin: 24rpx 16rpx 8rpx; padding: 20rpx 8rpx; background: #fff; border-radius: 36rpx; box-shadow: 0 8rpx 28rpx rgba(47,63,53,.05); }
.he { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.he-ic { font-style: normal; font-size: 38rpx; color: #5E9C80; width: 80rpx; height: 80rpx; border-radius: 50%; background: #F0F7F1; display: flex; align-items: center; justify-content: center; }
.he text { font-size: 20rpx; font-weight: 700; color: #5F6B62; }

.sec-head { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 28rpx 16rpx; }
.sh-b { font-size: 28rpx; font-weight: 800; }
.sh-s { font-size: 20rpx; color: #9AA49B; }
.hs-card { display: flex; align-items: center; gap: 24rpx; margin: 0 24rpx 18rpx; background: #fff; border-radius: 28rpx; padding: 24rpx 28rpx; box-shadow: 0 6rpx 24rpx rgba(47,63,53,.05); }
.hs-time { text-align: center; min-width: 116rpx; }
.hs-hm { font-size: 32rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.hs-day { font-size: 20rpx; color: #9AA49B; margin-top: 2rpx; }
.hs-main { flex: 1; min-width: 0; }
.hs-title { font-size: 26rpx; font-weight: 700; }
.hs-meta { font-size: 21rpx; color: #9AA49B; margin-top: 6rpx; }
.hs-cd { font-size: 23rpx; font-weight: 800; color: #4F8F71; white-space: nowrap; font-variant-numeric: tabular-nums; }

.home-shops { white-space: nowrap; padding: 4rpx 24rpx; }
.hshop { display: inline-block; width: 208rpx; margin-right: 20rpx; background: #fff; border-radius: 28rpx; padding: 24rpx 16rpx; text-align: center; box-shadow: 0 6rpx 24rpx rgba(47,63,53,.05); }
.hshop-glyph { width: 76rpx; height: 76rpx; margin: 0 auto; border-radius: 24rpx; background: #EDF6EF; border: 1.5px solid #CFE3D4; color: #4F8F71; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.hshop-name { font-size: 23rpx; font-weight: 700; margin-top: 14rpx; overflow: hidden; text-overflow: ellipsis; }
.hshop-type { font-size: 18rpx; color: #9AA49B; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; }
.hshop-rate { font-size: 20rpx; color: #C9962F; font-weight: 700; margin-top: 8rpx; }
.home-tip { text-align: center; font-size: 21rpx; color: #A9B2AA; margin: 32rpx 0 8rpx; letter-spacing: 4rpx; }
