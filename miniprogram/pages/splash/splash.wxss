.sp-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.sp-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.sp-veil {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(31,44,37,.18) 0%, rgba(31,44,37,.42) 45%, rgba(23,32,27,.82) 100%);
}
.sp-content { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 60rpx 90rpx; text-align: center; }
.sp-logo {
  width: 124rpx; height: 124rpx; margin: 0 auto 36rpx; border-radius: 40rpx;
  background: linear-gradient(135deg, #7FB69A, #4E8A6E); color: #fff; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(94,156,128,.45);
  animation: spLogo 2.2s ease-in-out infinite;
}
@keyframes spLogo { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
.sp-title { font-size: 54rpx; font-weight: 800; color: #fff; line-height: 1.5; letter-spacing: 6rpx; text-shadow: 0 4rpx 24rpx rgba(0,0,0,.35); }
.sp-sub { font-size: 24rpx; color: rgba(255,255,255,.85); margin-top: 20rpx; letter-spacing: 8rpx; }
.sp-enter {
  margin-top: 60rpx; padding: 26rpx 0; width: 100%; border-radius: 999rpx;
  background: rgba(255,255,255,.94); color: #3E7A5F; font-size: 30rpx; font-weight: 800;
  letter-spacing: 4rpx; border: none; box-shadow: 0 12rpx 40rpx rgba(0,0,0,.25);
}
.sp-enter::after { border: none; }
.sp-foot { margin-top: 36rpx; font-size: 16rpx; color: rgba(255,255,255,.55); letter-spacing: 7rpx; font-weight: 600; }
