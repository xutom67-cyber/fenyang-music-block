page { background: #F4F7F2; }
.page { padding-bottom: 60rpx; }
.page-sub { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx 20rpx; }
.sub-title { font-size: 34rpx; font-weight: 800; }
.prof-card { display: flex; align-items: center; gap: 26rpx; margin: 8rpx 24rpx 24rpx; background: #fff; border-radius: 32rpx; padding: 30rpx 32rpx; box-shadow: 0 8rpx 28rpx rgba(47,63,53,.05); }
.prof-avatar { width: 104rpx; height: 104rpx; border-radius: 50%; flex-shrink: 0; color: #fff; font-size: 48rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(94,156,128,.35); }
.prof-info { flex: 1; min-width: 0; }
.prof-name { font-size: 30rpx; font-weight: 800; display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.prof-badge { font-size: 19rpx; font-weight: 700; color: #4F8F71; background: #E8F4EC; padding: 5rpx 18rpx; border-radius: 999rpx; }
.prof-sub { font-size: 22rpx; color: #9AA49B; margin-top: 8rpx; }
.prof-bio { font-size: 22rpx; color: #6E7A71; margin-top: 10rpx; line-height: 1.6; }
.prof-edit { flex-shrink: 0; width: 60rpx; height: 60rpx; border-radius: 50%; border: 1.5px solid #E2E8E0; background: #F5F8F4; color: #5F6B62; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.stat-row { display: flex; gap: 16rpx; margin: 0 24rpx 24rpx; }
.stat-tile { flex: 1; background: #fff; border-radius: 28rpx; padding: 22rpx 8rpx; text-align: center; box-shadow: 0 6rpx 24rpx rgba(47,63,53,.05); }
.stat-tile .v { font-size: 34rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.stat-tile .k { font-size: 19rpx; color: #9AA49B; margin-top: 6rpx; }
.member-card { margin: 0 24rpx 28rpx; border-radius: 36rpx; padding: 30rpx 32rpx; overflow: hidden; background: linear-gradient(135deg, #7FB69A 0%, #5E9C80 55%, #4E8A6E 100%); box-shadow: 0 12rpx 36rpx rgba(94,156,128,.28); position: relative; }
.member-card::after { content: '♪♫♪'; position: absolute; right: -8rpx; bottom: -12rpx; font-size: 68rpx; color: rgba(255,255,255,.14); letter-spacing: 8rpx; transform: rotate(-8deg); }
.mc-top { display: flex; justify-content: space-between; align-items: center; }
.mc-title { color: #fff; font-size: 26rpx; font-weight: 800; letter-spacing: 1rpx; }
.mc-level { font-size: 20rpx; font-weight: 800; color: #3E7A5F; background: #fff; border-radius: 999rpx; padding: 6rpx 20rpx; }
.mc-main { display: flex; align-items: center; gap: 28rpx; margin-top: 26rpx; }
.mc-qr { width: 216rpx; height: 216rpx; background: #fff; border-radius: 24rpx; flex-shrink: 0; }
.mc-side { flex: 1; min-width: 0; }
.mc-code { color: #fff; font-size: 30rpx; font-weight: 800; letter-spacing: 5rpx; font-variant-numeric: tabular-nums; }
.mc-perks { margin-top: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.mc-perks view { font-size: 20rpx; color: rgba(255,255,255,.92); background: rgba(255,255,255,.14); border-radius: 16rpx; padding: 8rpx 18rpx; display: inline-block; width: fit-content; }
.sec-head { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx 16rpx; }
.sh-b { font-size: 28rpx; font-weight: 800; }
.sh-s { font-size: 20rpx; color: #9AA49B; }
.order-card { display: flex; align-items: center; gap: 24rpx; margin: 0 24rpx 20rpx; background: #fff; border-radius: 28rpx; padding: 24rpx 28rpx; box-shadow: 0 6rpx 24rpx rgba(47,63,53,.05); }
.oc-glyph { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #EDF6EF; border: 1.5px solid #CFE3D4; color: #4F8F71; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: 30rpx; flex-shrink: 0; }
.oc-info { flex: 1; min-width: 0; }
.oc-title { font-size: 26rpx; font-weight: 700; }
.oc-meta { font-size: 21rpx; color: #9AA49B; margin-top: 6rpx; line-height: 1.5; }
.oc-code { display: inline-block; margin-top: 10rpx; font-size: 19rpx; color: #6E7A71; background: #F2F5F0; border: 1px dashed #D8DED4; border-radius: 12rpx; padding: 4rpx 14rpx; letter-spacing: 3rpx; font-variant-numeric: tabular-nums; }
.oc-right { text-align: right; flex-shrink: 0; }
.oc-total { font-size: 30rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.oc-status { display: inline-block; margin-top: 10rpx; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 600; }
.oc-status.waiting { background: #E8F4EC; color: #4E9A6B; }
.oc-status.done { background: #F0F2EE; color: #9AA49B; }
.footer-note { text-align: center; font-size: 20rpx; color: #A9B2AA; margin: 30rpx 40rpx 0; line-height: 1.7; }
