page { background: #F4F7F2; }
.page { padding-bottom: 60rpx; }
.page-sub { padding: 24rpx 32rpx 20rpx; }
.sub-title { font-size: 34rpx; font-weight: 800; }
.hist-img-wrap { margin: 8rpx 24rpx 0; background: #fff; border-radius: 36rpx; padding: 20rpx; box-shadow: 0 12rpx 36rpx rgba(47,63,53,.06); }
.hist-img { width: 100%; border-radius: 24rpx; }
.hist-img-cap { text-align: center; font-size: 20rpx; color: #8B968E; margin-top: 16rpx; }
.hist-sec { margin: 28rpx 24rpx 0; background: #fff; border-radius: 32rpx; padding: 28rpx 32rpx; box-shadow: 0 8rpx 28rpx rgba(47,63,53,.05); }
.hist-title { font-size: 28rpx; font-weight: 700; position: relative; padding-left: 20rpx; }
.hist-title::before { content: ""; position: absolute; left: 0; top: 6rpx; bottom: 6rpx; width: 7rpx; border-radius: 4rpx; background: #7FB69A; }
.hist-body { display: block; font-size: 24rpx; line-height: 1.9; color: #5F6B62; margin-top: 16rpx; }
.footer-note { text-align: center; font-size: 20rpx; color: #A9B2AA; margin: 40rpx 40rpx 0; line-height: 1.7; }
